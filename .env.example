# ══════════════════════════════════════════════════════════════════
#  AI Experts Business Suite — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
IP_Address="YOUR_SERVER_IP"
Password="YOUR_SERVER_SSH_PASSWORD"

# ── Stripe ────────────────────────────────────────────────────────
Stripe_API_Key="sk_live_YOUR_STRIPE_API_KEY"

# ── kie.ai Image Generation ───────────────────────────────────────
KeyAI_API_KEY="YOUR_KIE_AI_API_KEY"

# ── LinkedIn OAuth ────────────────────────────────────────────────
Client_ID="YOUR_LINKEDIN_CLIENT_ID"
Client_Secret="YOUR_LINKEDIN_CLIENT_SECRET"
LinkedIn_Access_Token="YOUR_LINKEDIN_ACCESS_TOKEN"

# ── YouTube / Google ──────────────────────────────────────────────
YouTube_API_Key="YOUR_YOUTUBE_API_KEY"

# ── HeyGen (Avatar Video) ─────────────────────────────────────────
HeyGen_API_Key="YOUR_HEYGEN_API_KEY"
Avatar_ID="YOUR_HEYGEN_AVATAR_ID"

# ── Email (SMTP) ──────────────────────────────────────────────────
MAIL_PASSWORD="YOUR_SMTP_PASSWORD"
EMAIL_ADDRESS="YOUR_WORK_EMAIL"

# ── Azure OpenAI ──────────────────────────────────────────────────
Azure_API_Key="YOUR_AZURE_OPENAI_API_KEY"
AZURE_OPENAI_API_KEY="YOUR_AZURE_OPENAI_API_KEY"
AZURE_OPENAI_ENDPOINT="https://YOUR_RESOURCE_NAME.cognitiveservices.azure.com/"
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"
Target_URI="https://YOUR_RESOURCE_NAME.cognitiveservices.azure.com/openai/deployments/gpt-4o-mini/chat/completions?api-version=2025-01-01-preview"

# ── Fireflies (Meeting Transcription) ────────────────────────────
Fireflies_API_Key="YOUR_FIREFLIES_API_KEY"

# ── Webhook ───────────────────────────────────────────────────────
Webhook_Secret="YOUR_WEBHOOK_SECRET"

# ── GitHub ────────────────────────────────────────────────────────
Github_API_Key="YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
